digraph ER {
graph [rankdir=LR, splines=true, nodesep=0.35, ranksep=1.3, fontname="Helvetica", pad=0.4, label="Stock4event - Diagrama ER (PostgreSQL)\nLinha cheia = FK obrigatoria   |   Linha tracejada = FK opcional   |   PK=chave primaria  FK=chave estrangeira  UQ=unica   |   ? = aceita NULL", labelloc=t, fontsize=18];
node [shape=plain, fontname="Helvetica", fontsize=11]; edge [color="#555555", arrowsize=0.9];
