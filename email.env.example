# ─────────────────────────────────────────────────────────────────────────────
# E-mail de boas-vindas do Stock4event: modelo de configuração (SEM segredos)
#
# 1. Copie este arquivo para "email.env" (já está no .gitignore e não vai para o Git).
# 2. Preencha os valores e carregue as variáveis antes de subir o backend
#    (veja docs/EMAIL_BOAS_VINDAS.md, seção "Como carregar as variáveis").
# Nunca escreva a senha em application.properties nem no frontend.
# ─────────────────────────────────────────────────────────────────────────────

# Liga o envio. Com false (padrão), o cadastro funciona e nenhum e-mail é enviado.
STOCK4EVENT_EMAIL_HABILITADO=true

# Remetente que aparece para o usuário. O endereço precisa estar verificado no provedor.
STOCK4EVENT_EMAIL_REMETENTE=Stock4event <nao-responda@seudominio.com.br>

# Endereço REAL de acesso ao aplicativo, usado no botão "Acessar minha conta" (http ou https).
# Use a URL publicada do app (versão web, página de download ou link das lojas).
STOCK4EVENT_APP_URL=https://PREENCHA-COM-A-URL-DO-APP

# Servidor SMTP do provedor escolhido (ex.: smtp-relay.brevo.com, smtp.sendgrid.net, smtp.gmail.com).
SPRING_MAIL_HOST=smtp.seuprovedor.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=usuario-smtp
SPRING_MAIL_PASSWORD=senha-ou-chave-smtp

# Opcional: autenticação e STARTTLS (padrão true). Para o Mailpit local, use false nos dois.
# SPRING_MAIL_SMTP_AUTH=true
# SPRING_MAIL_SMTP_STARTTLS=true
